{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "uv sync --project backend --frozen --extra dev --extra timesfm-mlx && npm ci --prefix frontend",
      "problemMatcher": [],
      "inAgents": true,
      "runOptions": {
        "runOn": "worktreeCreated"
      }
    },
    {
      "label": "Start backend",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "inAgents": true
    },
    {
      "label": "Start frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "inAgents": true
    },
    {
      "label": "Start all services",
      "type": "shell",
      "command": "uv run --project backend python scripts/start_services.py",
      "problemMatcher": [],
      "inAgents": true
    }
  ]
}
