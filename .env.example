APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=5173
ALLOWED_ORIGINS=http://localhost:5173
MARKET_DATA_PROVIDER=yahoo
TRACKING_DATABASE_PATH=data/tracking.sqlite3
# Direct local backend runs use SQLite unless this PostgreSQL URL is set.
# TRACKING_DATABASE_URL=postgresql://timeseries@127.0.0.1:5432/timeseries

# Docker Compose PostgreSQL settings. Replace the password in the local .env.
POSTGRES_DB=timeseries
POSTGRES_USER=timeseries
POSTGRES_PASSWORD=replace-with-a-local-only-password
PGPASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5432

# Apple Silicon uses the MLX backend. Use pytorch/cpu as a slower fallback.
TIMESFM_BACKEND=mlx
TIMESFM_CHECKPOINT_ID=google/timesfm-3.0-pytorch
TIMESFM_CHECKPOINT_PATH=/Users/your-name/.cache/timesfm/google-timesfm-3.0-pytorch
# Docker Compose bind-mount source. Use the same absolute checkpoint directory.
TIMESFM_CHECKPOINT_HOST_PATH=/Users/your-name/.cache/timesfm/google-timesfm-3.0-pytorch
TIMESFM_DEVICE=auto
TIMESFM_MODEL_VERSION=3.0.2

MODEL_LOAD_TIMEOUT_SECONDS=180
FORECAST_TIMEOUT_SECONDS=30
REQUEST_TIMEOUT_SECONDS=15
